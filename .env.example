# UnSynth environment overrides (all optional).
# Local-first: leave these unset unless you explicitly want a cloud or remote backend.

# UNSYNTH_BACKEND=none|ollama|openai_compatible|transformers
# UNSYNTH_MODEL=llama3.1:8b
# UNSYNTH_OLLAMA_HOST=http://127.0.0.1:11434

# Optional OpenAI-compatible endpoint (never the default).
# UNSYNTH_OPENAI_BASE_URL=https://api.example.com/v1
# UNSYNTH_OPENAI_API_KEY=

# Optional future Anthropic Detection API.
# UNSYNTH_ANTHROPIC_API_KEY=
# UNSYNTH_ANTHROPIC_DETECTION_URL=

# Config file path override
# UNSYNTH_CONFIG=./unsynth.yaml
